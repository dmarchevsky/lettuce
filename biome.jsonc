{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/node_modules", "!web/dist", "!bun.lock", "!docker/secrets"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Matches the width the codebase was already written to; Biome defaults to 80.
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        // Gated, not advisory. Every effect that once depended on `scope?.agent_id`
        // / `scope?.conversation_id` instead of `scope` now has a memoized
        // `scope` to depend on (use-conversation.ts), so the one reason this was
        // downgraded — field-wise deps standing in for an unstable object — is
        // gone. A fresh object literal in a dependency list is the unbounded
        // app-server request loop documented in use-session.ts.
        "useExhaustiveDependencies": "error"
      },
      "suspicious": {
        // Index keys are correct for the lists that trigger this: diff hunks,
        // diff lines, git file rows, search matches, attachment chips and the
        // thumbnails of one message are all static while rendered and have no
        // id. Five of the six now carry a `biome-ignore` with its reason; the
        // sixth (message image thumbnails) cannot, because the formatter keeps
        // the `key` attribute off the element's own line and a suppression
        // comment must sit directly above what it excuses.
        "noArrayIndexKey": "warn"
      },
      "style": {
        // tsconfig sets noUncheckedIndexedAccess, which makes `!` the idiomatic
        // escape after an explicit length/guard check.
        "noNonNullAssertion": "warn"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      // Probe and test harnesses talk to the wire protocol, where `any` at the
      // boundary is the honest type and `!` follows an assertion that just ran.
      "includes": ["scripts/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
