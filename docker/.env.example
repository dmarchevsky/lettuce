# Copy this file to docker/.env and fill it in:
#
#   cp docker/.env.example docker/.env
#
# docker/.env is gitignored and is the ONLY place these settings belong. Compose
# reads it automatically because it sits next to compose.yml.
#
# Everything here has a default in docker/compose.yml or in the BFF itself, so
# a value you leave commented out is a value you are not setting. The full
# reference, including which variables each mode actually needs, is
# docs/CONFIGURATION.md.

# ── Required ────────────────────────────────────────────────────────────────

# The origin people open the app on. This is not cosmetic: the session cookie's
# `Secure` flag, the CSP's websocket allowance and the Google OAuth redirect are
# all derived from it. Must match what the browser actually types.
PUBLIC_ORIGIN=http://localhost:8090

# Signs the session cookie. Generate a real one — a guessable value lets anyone
# forge a session for any allowed user, and the server refuses to boot on a
# short or low-entropy secret.
#   openssl rand -hex 32
SESSION_SECRET=

# Do NOT set LETTA_CODE_VERSION here. The release this stack runs is pinned in
# docker/compose.yml (and in the three package.json files), and a value in this
# file outranks all of them — so it quietly freezes the stack on an old release
# and survives every later sync. `bun run check-version-pin` says so when it
# finds one. A host that genuinely needs an override passes it in the
# environment, where it is at least visible in the command that set it.

# ── Which images to run ──────────────────────────────────────────────
# A deploy host pulls the images CI publishes instead of building them. One line,
# set once, and the repo is public so the packages are: no `docker login`, no pull
# token, nothing else to configure.
# LETTA_IMAGE_NS=ghcr.io/dmarchevsky/
#
# Leave it unset and the images are named locally, which nothing can pull, so
# Compose builds them from this checkout — which is what a dev box wants, and what
# keeps a branch that bumped a pin from pulling LAST release's app-server instead
# of building its own.
#
# Which release those images are is `LETTA_IMAGE_TAG`'s default inside
# docker/compose.yml: the release this tree is, kept equal to VERSION by
# check-release-hygiene. Do not set it here — a value nobody updates freezes the
# host on an old release, exactly like LETTA_CODE_VERSION above. Set it only to
# run something else: `LETTA_IMAGE_TAG=latest` runs main's tip without a release.

# ── Where durable state lives ───────────────────────────────────────────────
# Anchors letta-home/, letta-data/, workspaces/ and tools/. The default is
# relative to docker/compose.yml, which is a trap: run compose from a git
# worktree and the stack comes up healthy against a DIFFERENT (usually empty)
# state directory.
# Set it absolutely and this never bites.
LETTA_STATE_DIR=/absolute/path/to/your/state/dir

# ── Access: how this instance is reached ────────────────────────────────────
# `lan` (default) — you reach it by address, on this machine or your network.
# `cloudflared`   — a Cloudflare Tunnel is the only way in; the port closes to
#                   the network and Cloudflare Access sits in front of it.
# It must agree with the `cloudflared` token in COMPOSE_PROFILES below, in both
# directions: a token with no tunnel is a route you think you have and do not,
# and a tunnel with `ACCESS=lan` leaves a public door you did not mean to open.
# Unset derives from the profile token, so an older file keeps its behaviour.
# ACCESS=lan

# Where the published port listens on the HOST. Loopback by default, so nothing
# reaches this instance that you did not aim at. Your phone on the LAN needs
# 0.0.0.0 — and then SIGNIN (below) is the only thing between it and your agent.
# With ACCESS=cloudflared a wide bind is refused at boot: the tunnel reaches the
# BFF over Docker's own network, so the published port is a second door.
# BFF_BIND=0.0.0.0

# Host port for the app.
# BFF_PORT=8090

# ── Sign-in: who has to prove who they are ──────────────────────────────────
# Independent of ACCESS — a LAN install can ask for a password and a tunneled
# one can still ask its owner to sign in rather than trusting Access alone.
# One of:
#
#   none        nobody is asked; whoever reaches the port is the owner. Only
#               allowed with BFF_BIND on loopback, so this is "the machine I
#               am sitting at", never "the machine on my desk".
#   password    one password, set in the browser on first run, stored as a
#               scrypt hash on the bff-auth volume. For a LAN you trust.
#   cf-access   Cloudflare Access decides, before a request arrives; needs
#               ACCESS=cloudflared, the CF_ACCESS_* trio below and ALLOWED_USERS.
#   google      a Google account from ALLOWED_USERS, via the OAuth client below.
#
# Unset derives: cf-access with the tunnel, password without it — the new default
# for a LAN install, so an upgrade from the old dev bypass asks for a credential in the
# browser instead of leaving the door off.
# SIGNIN=password

# The only place an address list comes from, and it means something only for the
# methods that receive one: required for SIGNIN=cf-access and SIGNIN=google,
# ignored (with a boot warning) by none and password. Comma-separated; for
# cf-access it is NOT kept in sync with the Access policy automatically.
# ALLOWED_USERS=you@example.com

# Sign-in and Settings → Google Workspace share ONE Google OAuth client —
# env rather than Settings, because signing in happens before anyone could open
# Settings. Register BOTH redirect URIs in the Google console:
#   https://your-origin/auth/google/callback
#   https://your-origin/api/google/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ── Timezone ────────────────────────────────────────────────────────────────
# The timezone every container runs in: cron schedules, conversation and memory
# timestamps, and container logs all follow it. Docker's default is UTC; this
# stack defaults to Pacific. Any IANA name works (e.g. Europe/Berlin).
# TZ=America/Los_Angeles

# ── Profiles (which containers exist, and which features are on) ───────────
# One setting decides which optional services Compose creates AND how the BFF
# behaves. Keep any profile you already have when adding another.
#
#   cloudflared  the Cloudflare Tunnel container; makes the app public, and
#                must agree with ACCESS above
#   google       the Gmail/Calendar/Tasks sidecar + Settings → Google Workspace
#   search       SearXNG + ddg-mcp, behind the agents' web tools + Settings → Web
#   telegram     the messaging channel gateway
#   codex        virtual: installs the Codex CLI into the app-server image and
#                turns on Settings → Codex workers (no container)
#   claude       virtual: same for the Claude Code CLI and Settings → Claude Code
#
# The coding tokens install at BUILD time: adding or removing one REQUIRES a
# rebuild of app-server (compose up without --build silently keeps the old
# image), and must match exactly as a comma-delimited token — `searchy` is not
# `search`. Unset means no tunnel and none of the optional services, which is what
# a laptop checkout wants; see ACCESS and SIGNIN above for what that leaves open.
# COMPOSE_PROFILES=cloudflared,google,search,codex,claude

# ── Cloudflare Access (ACCESS=cloudflared + SIGNIN=cf-access) ────────────────
# All of this comes from the Zero Trust dashboard; see the deployment section
# of docs/CONFIGURATION.md for the setup walkthrough.
# CLOUDFLARE_TUNNEL_TOKEN=
# CF_ACCESS_TEAM_DOMAIN=acme
# CF_ACCESS_AUD=<Access application Audience tag>
# Only during a Zero Trust team rename, while old tokens still name the old team:
# CF_ACCESS_ISSUER=https://old-team.cloudflareaccess.com

# ── Session and tuning (optional) ───────────────────────────────────────────
# SESSION_TTL_SECONDS=2592000
# FRAME_BUFFER_SIZE=5000
# SHUTDOWN_DRAIN_TIMEOUT_SECONDS=900

# ── Push notifications (optional; all three or none) ────────────────────────
# Generate a keypair with:  cd bff && bunx web-push generate-vapid-keys
# Setting only some of these turns push off silently, so a typo looks exactly
# like "not configured".
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_CONTACT_EMAIL=you@example.com

# ── Web search (needs the `search` profile) ────────────────────────────────
# SEARXNG_VERSION=2026.10.9-9f042d2f6
# SEARXNG_URL=http://searxng:8080
# DDG_MCP_VERSION=0.7.0
# DDG_MCP_URL=http://ddg-mcp:8000/mcp
# DDG_REGION=us-en
# DDG_SAFE_SEARCH=OFF

# ── Google Workspace (needs the `google` profile) ──────────────────────────
# The OAuth client is GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above — one client,
# shared with sign-in, and Settings → Google Workspace falls back to whatever it
# holds when those are unset. The permission levels live in Settings, not here.
# GOOGLE_OAUTH_REDIRECT_URI=
# Letting an unauthenticated session (`SIGNIN=none`) change the Google policy.
# Refused by default: agent shells share this container's network namespace and can
# reach this loopback port, so under `none` one of them could grant itself Google
# access. Setting this to true says you accept that.
# GOOGLE_ALLOW_INSECURE_SIGNIN=false

# ── Web apps agents serve ──────────────────────────────────────────────────
# Agents can run small web apps; only ports 3000-3099 are published, and they
# have NO authentication. Set AGENT_APP_HOST to the address people should open
# them on, and narrow AGENT_APPS_BIND if 0.0.0.0 is broader than you want.
# AGENT_APP_HOST=
# AGENT_APPS_BIND=0.0.0.0
